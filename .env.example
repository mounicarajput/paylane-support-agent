# Primary: open-source model through Ollama (no API key)
PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
# Slow laptop? Wait longer for a reply and keep the model loaded between messages.
OLLAMA_TIMEOUT=900
OLLAMA_KEEP_ALIVE=60m

# Optional: Anthropic Sonnet (set PROVIDER=anthropic and pip install anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

TEMPERATURE=0
SEED=7
